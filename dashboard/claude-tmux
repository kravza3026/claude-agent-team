#!/bin/sh
# Запуск Claude у tmux, щоб дашборд міг вводити команди в сесію (режим «tmux»).
# Використання: claude-tmux [аргументи claude]   (напр.: claude-tmux --continue --channels plugin:telegram@claude-plugins-official)
[ -x "$HOME/.local/bin/tmux" ] && ! command -v tmux >/dev/null 2>&1 && PATH="$HOME/.local/bin:$PATH"
command -v tmux >/dev/null 2>&1 || { echo "tmux не знайдено: встановіть tmux (Linux/macOS) або запускайте claude без обгортки (команди підуть чергою через хуки)." >&2; exit 1; }
if [ -n "$TMUX" ]; then exec claude "$@"; fi
name="claude-$(basename "$PWD" | tr -c 'A-Za-z0-9_-' '_')"
# claude-run лишає вікно відкритим, якщо claude завершився з помилкою
exec tmux new-session -A -s "$name" "$(dirname "$0")/claude-run" "$@"
